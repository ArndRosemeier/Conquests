{
  "name": "conquests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Conquests: grand strategy of rival empires, 1880-1914, in the browser.",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "gen:world": "vite-node scripts/generateEarth.ts",
    "sim": "vite-node scripts/simulate.ts",
    "ab": "vite-node scripts/abtest.ts",
    "exp:knob": "vite-node scripts/experimentRisk.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vite-node scripts/balance.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
